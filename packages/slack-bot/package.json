{
  "name": "@dx-template/slack-bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:local": "tsx watch src/dev-server.ts",
    "build": "tsc",
    "generate:api": "openapi-typescript ../server/openapi.json -o src/lib/api/schema.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@slack/bolt": "^5.1.0",
    "openapi-fetch": "^0.17.0",
    "slack-block-builder": "^2.8.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "msw": "^3.0.4",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
