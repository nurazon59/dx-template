{
  "name": "@dx-template/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @dx-template/agent build",
    "dev": "NODE_OPTIONS=--conditions=development tsx watch src/index.ts",
    "prebuild": "pnpm --filter @dx-template/agent build",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:openapi": "tsx src/scripts/generate-openapi.ts > openapi.json"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1163.0",
    "@aws-sdk/client-s3": "^3.1163.0",
    "@aws-sdk/lib-dynamodb": "^3.1163.0",
    "@aws-sdk/s3-request-presigner": "^3.1163.0",
    "@dx-template/agent": "workspace:*",
    "@dx-template/shared": "workspace:*",
    "@dx-template/workflow": "workspace:*",
    "@hono/node-server": "^2.1.6",
    "@hono/standard-validator": "^0.4.1",
    "@scalar/hono-api-reference": "^0.12.18",
    "@standard-community/standard-json": "^0.4.0",
    "@standard-community/standard-openapi": "^0.2.11",
    "@types/json-schema": "^7.0.15",
    "better-auth": "^1.7.18",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "hono-openapi": "^1.5.0",
    "openapi-types": "^12.1.3",
    "postgres": "^4.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
